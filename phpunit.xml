<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!--
            Enumerated rather than pointed at tests/Feature wholesale because
            tests/Feature/Http holds Blueprint-generated API scaffolds that were
            never converted to this app's Inertia conventions (97 of its 129
            tests fail against controllers that redirect rather than return JSON).
            Every other directory belongs here — leaving one out means its tests
            silently never run.
        -->
        <testsuite name="Feature">
            <directory>tests/Feature/Accounting</directory>
            <directory>tests/Feature/Administration</directory>
            <directory>tests/Feature/Hr</directory>
            <directory>tests/Feature/Inventory</directory>
            <directory>tests/Feature/Ledger</directory>
            <directory>tests/Feature/Purchase</directory>
            <directory>tests/Feature/Sales</directory>
            <directory>tests/Feature/Reports</directory>
            <directory>tests/Feature/Notifications</directory>
            <directory>tests/Feature/System</directory>
            <directory>tests/Feature/UserManagement</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
