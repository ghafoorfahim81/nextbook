{
  "permissions": {
    "allow": [
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(git push *)",
      "PowerShell(dropdb *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
